* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #111827;
    background: #ffffff;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1120px, 92%);
    margin: auto;
}


/* NAVBAR */

.navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #e5e7eb;
    backdrop-filter: blur(10px);
}

.nav-content {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 20px;
    font-weight: 800;
}

.logo span {
    font-weight: 400;
    color: #6b7280;
}

nav {
    display: flex;
    gap: 28px;
}

nav a {
    font-size: 14px;
    color: #4b5563;
}

nav a:hover {
    color: #111827;
}


/* HERO */

.hero {
    padding: 100px 0;
    background: #f8fafc;
}

.hero-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 70px;
}

.tag {
    color: #2563eb;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -3px;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #2563eb;
}

.hero-description {
    max-width: 600px;
    color: #64748b;
    font-size: 18px;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 22px;
    border-radius: 8px;
    font-weight: 700;
    border: 1px solid transparent;
    cursor: pointer;
    transition: 0.2s;
}

.primary {
    background: #111827;
    color: white;
}

.primary:hover {
    background: #2563eb;
}

.secondary {
    border-color: #d1d5db;
    background: white;
}

.secondary:hover {
    border-color: #111827;
}


/* WEBSITE MOCKUP */

.hero-card {
    background: #111827;
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.18);
}

.card-top {
    display: flex;
    gap: 7px;
    margin-bottom: 25px;
}

.card-top span {
    width: 9px;
    height: 9px;
    background: #64748b;
    border-radius: 50%;
}

.code-line {
    height: 10px;
    background: #334155;
    border-radius: 10px;
    width: 75%;
    margin-bottom: 12px;
}

.code-line.large {
    width: 90%;
}

.code-line.short {
    width: 50%;
}

.website-preview {
    background: white;
    border-radius: 12px;
    padding: 25px;
    margin-top: 25px;
}

.preview-title {
    height: 16px;
    width: 65%;
    background: #111827;
    border-radius: 5px;
    margin-bottom: 12px;
}

.preview-text {
    height: 9px;
    width: 85%;
    background: #cbd5e1;
    border-radius: 5px;
    margin-bottom: 25px;
}

.preview-boxes {
    display: flex;
    gap: 10px;
}

.preview-boxes div {
    height: 70px;
    flex: 1;
    background: #e2e8f0;
    border-radius: 8px;
}


/* SECTIONS */

.section {
    padding: 100px 0;
}

.section-heading {
    max-width: 650px;
    margin-bottom: 50px;
}

.section-heading h2 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.1;
    margin-bottom: 15px;
}

.section-heading > p:last-child {
    color: #64748b;
}


/* SERVICES */

.services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.service-card {
    border: 1px solid #e5e7eb;
    padding: 30px;
    border-radius: 12px;
    transition: 0.25s;
}

.service-card:hover {
    transform: translateY(-5px);
    border-color: #2563eb;
}

.icon {
    font-size: 13px;
    color: #2563eb;
    font-weight: 800;
    margin-bottom: 35px;
}

.service-card h3 {
    margin-bottom: 12px;
}

.service-card p {
    color: #64748b;
    font-size: 14px;
}


/* DARK SECTION */

.dark-section {
    background: #111827;
    color: white;
}

.light .tag {
    color: #60a5fa;
}

.light > p:last-child {
    color: #94a3b8;
}

.features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.features div {
    border-top: 1px solid #334155;
    padding-top: 25px;
}

.features strong {
    color: #60a5fa;
}

.features h3 {
    margin: 12px 0 8px;
}

.features p {
    color: #94a3b8;
}


/* PROCESS */

.process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.process-card {
    padding: 28px;
    background: #f8fafc;
    border-radius: 12px;
}

.process-card span {
    color: #2563eb;
    font-weight: 800;
}

.process-card h3 {
    margin: 25px 0 10px;
}

.process-card p {
    color: #64748b;
    font-size: 14px;
}


/* CONTACT */

.contact-section {
    background: #f8fafc;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
}

.contact-grid h2 {
    font-size: clamp(36px, 5vw, 55px);
    line-height: 1.1;
    margin-bottom: 20px;
}

.contact-grid > div > p {
    color: #64748b;
}

.contact-info {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.contact-info div {
    display: flex;
    flex-direction: column;
}

.contact-info span {
    font-size: 12px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.contact-info a {
    color: #2563eb;
    font-weight: 700;
}


/* FORM */

.contact-form {
    background: white;
    padding: 30px;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

.contact-form label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 7px;
    margin-top: 18px;
}

.contact-form label:first-child {
    margin-top: 0;
}

.contact-form input,
.contact-form select,
.contact-form textarea {
    width: 100%;
    border: 1px solid #d1d5db;
    border-radius: 7px;
    padding: 13px;
    font-family: inherit;
    font-size: 14px;
    outline: none;
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
    border-color: #2563eb;
}

.contact-form textarea {
    resize: vertical;
}

.full {
    width: 100%;
    margin-top: 20px;
}

#formMessage {
    text-align: center;
    margin-top: 15px;
    font-size: 14px;
    font-weight: 700;
}


/* FOOTER */

footer {
    background: #0f172a;
    color: white;
    padding: 50px 0 20px;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    gap: 30px;
}

.footer-content p {
    color: #94a3b8;
    margin-top: 8px;
    font-size: 14px;
}

.footer-content > div:last-child {
    display: flex;
    gap: 20px;
}

.footer-content a {
    color: #cbd5e1;
    font-size: 14px;
}

.copyright {
    text-align: center;
    border-top: 1px solid #1e293b;
    margin-top: 40px;
    padding-top: 20px;
    color: #64748b;
    font-size: 13px;
}


/* MOBILE */

@media (max-width: 900px) {

    .hero-content,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        padding: 70px 0;
    }

}


@media (max-width: 600px) {

    .nav-content {
        min-height: 65px;
    }

    nav {
        display: none;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .services-grid,
    .process-grid,
    .features {
        grid-template-columns: 1fr;
    }

    .section {
        padding: 70px 0;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .footer-content {
        flex-direction: column;
    }

    .footer-content > div:last-child {
        flex-wrap: wrap;
    }

}
